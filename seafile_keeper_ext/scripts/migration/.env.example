# .env for the KEEPER self-service data transfer
# Location: /opt/seafile/scripts/migration/.env      (cp .env.example .env)
#
# This single .env is shared by:
#   - process_keeper_email_migrations.py  (the worker)
#   - migrate_account.py / seafile_common.py  (the migration pipeline the worker runs)
# The worker loads it AND auto-imports most settings from /opt/seafile/keeper-*.ini,
# then runs migrate_account.py as a subprocess that inherits this environment.
#
# Almost everything is AUTO-IMPORTED, so the only value you normally need to set
# is SEAFILE_AUTH_TOKEN below. Everything else is optional override.

# =====================================================================
# (A) NORMALLY REQUIRED
# =====================================================================

# Seafile admin API token. REQUIRED for unattended runs: if blank, the pipeline
# prompts interactively for admin credentials on first run and the cron worker
# would HANG. Generate once (e.g. run migrate_account.py interactively, or via the
# Seafile admin API) and paste it here.
SEAFILE_AUTH_TOKEN=

# =====================================================================
# (B) OPTIONAL OVERRIDES (auto-imported from keeper-*.ini / conf/.env otherwise)
# =====================================================================

# Seafile server URL. Auto-defaults to this instance (keeper-*.ini __SERVER_NAME__).
#SEAFILE_SERVER_URL=https://qa-keeper.mpdl.mpg.de

# Where the privileged steps run. LEAVE EMPTY to run on THIS host with no SSH.
# Set both to use a remote host over SSH instead:
#KEEPER_MIGRATE_SERVER=
#KEEPER_SSH_USER=

# MySQL creds used by migrate_account.py (auto: same MySQL server as keeper-db / __DB_*):
#MYSQL_HOST=
#MYSQL_USER=
#MYSQL_PASSWORD=

# keeper-db queue the worker reads (auto: __DB_*; db name is always keeper-db):
#KEEPER_DB_HOST=127.0.0.1
#KEEPER_DB_PORT=3306
#KEEPER_DB_NAME=keeper-db
#KEEPER_DB_USER=keeper
#KEEPER_DB_PASSWORD=changeme

# Worker behaviour / locations:
#MIGRATION_SCRIPT_DIR=/opt/seafile/scripts/migration
#MIGRATION_ALWAYS_CREATE=0
#SEAFILE_DIR=/opt/seafile

# Notification email page link (auto: __SERVER_PROTOCOL__://__SERVER_NAME__/account/migrate/):
#MIGRATION_PAGE_URL=https://qa-keeper.mpdl.mpg.de/account/migrate/

# SMTP overrides (auto: __EMAIL_*, __DEFAULT_FROM_EMAIL__):
#EMAIL_HOST=localhost
#EMAIL_PORT=25
#EMAIL_USE_TLS=False
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#DEFAULT_FROM_EMAIL=keeper@mpdl.mpg.de
#SUPPORT_EMAIL=keeper@mpdl.mpg.de
